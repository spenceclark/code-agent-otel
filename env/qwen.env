# Qwen Code - default-privacy run (i.e. Qwen's own defaults, made explicit).
# Verified against https://qwenlm.github.io/qwen-code-docs/en/developers/development/telemetry/
# (page "Last updated on September 23, 2026", fetched 2026-10-09).
# Env vars override .qwen/settings.json; see env/qwen-settings.example.json for the
# equivalent settings block.

QWEN_TELEMETRY_ENABLED=true
# Informational label only - does not control routing.
QWEN_TELEMETRY_TARGET=local
QWEN_TELEMETRY_OTLP_ENDPOINT=http://127.0.0.1:4317
QWEN_TELEMETRY_OTLP_PROTOCOL=grpc

# NOTE: Qwen's default for logPrompts is TRUE - prompts and API request/response
# text land in the OTel *logs* out of the box. This is the "default privacy" run,
# so we keep the default. Use `scripts/run-qwen.sh --no-prompts` to see it redacted.
QWEN_TELEMETRY_LOG_PROMPTS=true

# Default false: no GenAI message/tool-argument/tool-result JSON on spans.
QWEN_TELEMETRY_INCLUDE_SENSITIVE_SPAN_ATTRIBUTES=false
