# Claude Code - default-privacy run.
# Verified against https://code.claude.com/docs/en/monitoring-usage (fetched 2026-10-09).
# Sourced by scripts/run-claude.sh. Plain KEY=value lines only.

# Telemetry on (required) + span tracing (beta, required for traces).
CLAUDE_CODE_ENABLE_TELEMETRY=1
CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1

# All three signals over OTLP.
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_TRACES_EXPORTER=otlp

# Claude Code has NO default protocol - it must be set explicitly.
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317

# Short export intervals so a one-shot `claude -p` run flushes quickly (ms).
OTEL_METRIC_EXPORT_INTERVAL=5000
OTEL_LOGS_EXPORT_INTERVAL=1000
OTEL_TRACES_EXPORT_INTERVAL=1000

# Default is delta; Prometheus is happier with cumulative.
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=cumulative

# Add app.version to metrics (default false) so runs are attributable to a release.
OTEL_METRICS_INCLUDE_VERSION=true

# Content gates (OTEL_LOG_USER_PROMPTS, OTEL_LOG_TOOL_DETAILS, OTEL_LOG_TOOL_CONTENT)
# are OFF by default, so they're left unset here. run-claude.sh also unsets any you
# have exported in your shell. OTEL_LOG_ASSISTANT_RESPONSES falls back to
# OTEL_LOG_USER_PROMPTS; `0` is the documented way to keep responses redacted.
OTEL_LOG_ASSISTANT_RESPONSES=0
