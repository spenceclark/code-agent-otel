# Qwen Code - full-content overlay, loaded ON TOP of env/qwen.env by
# `scripts/run-qwen.sh --full-content`.
# Adds gen_ai.input.messages / gen_ai.output.messages / gen_ai.system_instructions /
# gen_ai.tool.definitions / gen_ai.tool.call.arguments / gen_ai.tool.call.result as
# native span attributes (up to 1 MiB each by default).

QWEN_TELEMETRY_LOG_PROMPTS=true
QWEN_TELEMETRY_INCLUDE_SENSITIVE_SPAN_ATTRIBUTES=true
