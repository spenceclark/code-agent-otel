# Claude Code - full-content overlay. Loaded ON TOP of env/claude.env by
# `scripts/run-claude.sh --full-content`.
# WARNING: this puts prompts, responses, bash commands, file paths, file contents
# and diffs into ./captures. It's all local, but treat captures/ as sensitive.

OTEL_LOG_USER_PROMPTS=1
OTEL_LOG_ASSISTANT_RESPONSES=1
OTEL_LOG_TOOL_DETAILS=1
OTEL_LOG_TOOL_CONTENT=1

# Not enabled by default even in full-content mode: OTEL_LOG_RAW_API_BODIES emits the
# full Messages API request/response JSON (whole conversation history, system prompt,
# tool definitions) as api_request_body / api_response_body log events.
# `1` = inline, truncated at 60 KB; `file:<dir>` = untruncated files on disk.
# Enable with: scripts/run-claude.sh --full-content --raw-bodies
# OTEL_LOG_RAW_API_BODIES=1
