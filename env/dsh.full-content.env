# DeepSeek Harness - full-content overlay, loaded ON TOP of env/dsh.env by
# `scripts/run-dsh.sh --full-content`.

# Plugin: prompts, responses, tool definitions, arguments and results on spans
# (up to contentMaxChars=128000 per attribute). SPAN_AND_EVENT does the same.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=SPAN_ONLY

# Built-in exporter: every session-log record, live, as OTel logs. Unredacted:
# message content, tool args/results, system prompt, tool schemas, cwd.
DSH_TELEMETRY_MODE=FULL
